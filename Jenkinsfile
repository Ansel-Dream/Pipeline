pipeline {
    agent any

    stages {
        // First Stage
        stage('Hello') {
            steps {
                echo 'Hello World'
            }
        }
        
        // Second Stage
        stage('How?') {
            steps {
                echo 'How Are you buddy?'
            }
        }
        
        // Third Stage
        stage('going?') {
            steps {
                echo 'How are you doing?'
            }
        }
        
        // Final Stage
        stage('GoodBye') {
            steps {
                echo 'SO good to see you, Bye!'
            }
        }
    }
}
